# Copy file nay thanh .env roi dien thong tin cua ban. KHONG commit file .env.
DB_SERVER=localhost
DB_NAME=FitLifeHub

# Cach 1: Windows Authentication (khong can user/password)
DB_TRUSTED=1

# Cach 2: tai khoan SQL (dat DB_TRUSTED=0 hoac xoa dong tren)
# DB_USER=sa
# DB_PASSWORD=

# ODBC driver (doi neu may dung ban khac)
# DB_DRIVER=ODBC Driver 18 for SQL Server

# 0 = ket noi SQL Server that va chay stored procedure (dung khi da nap du lieu).
# 1 = che do STUB: KHONG doc DB, chi tra ve thong bao "STUB" + tham so da nhap,
#     dung de xem thu giao dien khi may chua cai SQL Server.
FITLIFE_STUB=0

# Them nguon CORS, cach nhau dau phay
# CORS_ORIGINS=
